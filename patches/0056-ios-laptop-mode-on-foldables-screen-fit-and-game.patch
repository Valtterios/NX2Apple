+// The C side of the game data download (GameData.h).
+#import "GameData.h"
+#include "hle_profile.h"
+#include "romfs_identity.h"
+#include "../../gfx/nvn/dmsh_chain.h"   // DMSH_CHAIN, the version the host's shader loader looks for (nvn_mtl.m shmap_load)
+
+NSString *dm_game_title(void) { return @(dm_profile()->id); }
+
+NSString *dm_game_dir(void) {
+    NSString *doc = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES)[0];
+    return [[doc stringByAppendingPathComponent:@"games"] stringByAppendingPathComponent:dm_game_title()];
+}
+
+static NSString *bundle_romfs_id(void) { return [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"romfs.id"]; }
+
+NSString *dm_expected_romfs_identity(void) {
+    NSString *s = [NSString stringWithContentsOfFile:bundle_romfs_id() encoding:NSUTF8StringEncoding error:nil];
+    s = [s stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    return s.length ? s : nil;
+}
+
+int dm_romfs_status(NSString *path) {
+    romfs_id want, got;
+    switch (romfs_id_check(bundle_romfs_id().fileSystemRepresentation, path.fileSystemRepresentation, &want, &got)) {
+    case ROMFS_ID_OK: return 0;
+    case ROMFS_ID_NONE: { romfs_id any; return romfs_id_of_image(path.fileSystemRepresentation, &any) ? 0 : (errno == ENOENT ? 1 : 2); }
+    case ROMFS_ID_MISSING: return 1;
+    case ROMFS_ID_UNREADABLE: return 2;
+    case ROMFS_ID_DIFFERENT: return 3;
+    default: return -1;
+    }
+}
+
+NSString *dm_shader_dir_name(void) { return @"b-" DMSH_CHAIN; }
+
+BOOL dm_have_shaders(void) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSString *own = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"msl"];   // the app's own: b-<version> for an NVN game, vk/ or gl/ for the others
+    NSString *dl = [[dm_game_dir() stringByAppendingPathComponent:@"msl"] stringByAppendingPathComponent:dm_shader_dir_name()];
+    NSString *tar = [dm_game_dir() stringByAppendingPathComponent:@"msl.tar"];   // read in place by the host (nvn_mtl.m msl_pack_open)
+    return [fm fileExistsAtPath:own] || [fm fileExistsAtPath:dl] || [fm fileExistsAtPath:tar];
+}
diff --git a/dm/ios/Sources/GameDataBackground.swift b/dm/ios/Sources/GameDataBackground.swift
new file mode 100644
index 0000000..7207795
--- /dev/null
+++ b/dm/ios/Sources/GameDataBackground.swift
@@ -0,0 +1,131 @@
+// Game data download in the background: the pieces GameDataSync.prepare() left to fetch are handed to iOS's own download service (a background URLSession),
+// which keeps fetching while the app is in the background or not running. Each finished piece comes back here, in this launch or a later one: it is checked
+// against the manifest's SHA-256, written in place into <name>.part and recorded in <name>.part.json, exactly as the foreground mode does (GameDataSyncCore.swift).
+// Only a window of pieces is queued at a time (iOS keeps a finished piece as a file until the app takes it, so queueing all of a 17 GB game would need the space
+// twice); the next ones are queued as pieces come back. Inside LiveContainer the session belongs to LiveContainer's process: whether iOS keeps it going there
+// has to be seen on the device, and the foreground mode stays available either way.
+// Foundation and CryptoKit only, so the same file builds into the Mac test (with an ordinary session in place of the background one).
+import Foundation
+import CryptoKit
+
+final class GameDataBackground: NSObject, URLSessionDownloadDelegate, @unchecked Sendable {
+    static let window = 64                         // pieces queued at once: 1 GB, the most iOS holds for the app while it is away
+    private static var live: [String: GameDataBackground] = [:]   // one per session identifier and process: iOS allows no second session with the same identifier
+    private static let liveLock = NSLock()
+    private static var eventsDone: [String: () -> Void] = [:]   // the app delegate's completion handler for a relaunch in the background (main.m)
+    static func liveLockedSetDone(_ id: String, _ h: @escaping () -> Void) { liveLock.withLock { eventsDone[id] = h } }
+
+    let identifier: String
+    private(set) var sync: GameDataSync   // the latest start's: its token and progress counters
+    private var session: URLSession!
+    private let q = DispatchQueue(label: "gamedata.background")   // plans, states and the part files are touched on this queue only
+    private var plans: [String: GameDataSync.FilePlan] = [:]
+    private var states: [String: GameDataSync.FileState] = [:]
+    private var queued = Set<String>()             // "<name>#<piece>" handed to iOS and not back yet
+    private var retries: [String: Int] = [:]
+    private(set) var lastError: String?
+    var onProgress: (() -> Void)?
+
+    /// The session for this game, made once per process. config: nil = a background session (the app); the Mac test passes an ordinary one.
+    static func shared(identifier: String, sync: GameDataSync, config: URLSessionConfiguration? = nil) -> GameDataBackground {
+        liveLock.withLock {
+            if let b = live[identifier] { b.q.sync { b.sync = sync }; return b }
+            let b = GameDataBackground(identifier: identifier, sync: sync, config: config)
+            live[identifier] = b; return b
+        }
+    }
+
+    private init(identifier: String, sync: GameDataSync, config: URLSessionConfiguration?) {
+        self.identifier = identifier; self.sync = sync
+        super.init()
+        let c = config ?? URLSessionConfiguration.background(withIdentifier: identifier)
+        if config == nil { c.isDiscretionary = false; c.sessionSendsLaunchEvents = true }
+        c.httpMaximumConnectionsPerHost = GameDataSync.chunkParallel
+        c.requestCachePolicy = .reloadIgnoringLocalCacheData; c.urlCache = nil
+        let dq = OperationQueue(); dq.maxConcurrentOperationCount = 1
+        session = URLSession(configuration: c, delegate: self, delegateQueue: dq)
+        // Pieces still with iOS from an earlier launch count as queued; any it already finished are delivered to the delegate below
+        session.getAllTasks { [self] ts in q.sync { for t in ts { if let d = t.taskDescription { queued.insert(d) } } } }
+    }
+
+    private func load(_ name: String) -> Bool {
+        if plans[name] != nil && states[name] != nil { return true }
+        guard let p = try? JSONDecoder().decode(GameDataSync.FilePlan.self, from: Data(contentsOf: sync.planURL(name))),
+              let s = try? JSONDecoder().decode(GameDataSync.FileState.self, from: Data(contentsOf: sync.stateURL(name))), s.identity == p.identity else { return false }
+        plans[name] = p; states[name] = s; return true
+    }
+
+    /// Queues the next pieces of these files (the shader archive first, then the image), up to the window.
+    func pump(_ names: [String]) {
+        q.async { [self] in
+            for name in names where load(name) {
+                let p = plans[name]!, s = states[name]!
+                for i in s.done.indices where !s.done[i] {
+                    if queued.count >= Self.window { return }
+                    let d = "\(name)#\(i)"
+                    if queued.contains(d) || (retries[d] ?? 0) > 6 { continue }   // given up on: lastError says so, and Download starts it again
+                    let lo = Int64(i) * p.chunkSize, r = lo ..< min(lo + p.chunkSize, p.size)
+                    let t = session.downloadTask(with: sync.request(p.url, range: r))
+                    t.taskDescription = d; t.countOfBytesClientExpectsToReceive = r.len
+                    queued.insert(d); t.resume()
+                }
+            }
+        }
+    }
+
+    /// A new start: forget earlier failures (and errors), so every missing piece is tried again.
+    func reset() { q.sync { retries.removeAll(); lastError = nil; plans.removeAll(); states.removeAll() } }
+
+    /// Pause: everything still queued is cancelled; the pieces already in place stay.
+    func cancelAll() {
+        session.getAllTasks { [self] ts in ts.forEach { $0.cancel() }; q.async { self.queued.removeAll() } }
+    }
+
+    var pending: Int { q.sync { queued.count } }
+
+    // MARK: URLSessionDownloadDelegate
+
+    func urlSession(_ s: URLSession, downloadTask t: URLSessionDownloadTask, didFinishDownloadingTo location: URL) {
+        // The file at location is gone when this returns: it is read, checked and written here
+        guard let d = t.taskDescription, let hash = d.lastIndex(of: "#"), let i = Int(d[d.index(after: hash)...]) else { return }
+        let name = String(d[..<hash])
+        let code = (t.response as? HTTPURLResponse)?.statusCode ?? 0
+        let data = try? Data(contentsOf: location, options: .mappedIfSafe)
+        q.sync {
+            queued.remove(d)
+            guard load(name), var st = states[name], let p = plans[name], i < st.done.count else { return }
+            let lo = Int64(i) * p.chunkSize, len = min(lo + p.chunkSize, p.size) - lo
+            if code == 401 || code == 403 { lastError = "The server refused access (HTTP \(code)): check the access token."; return }
+            guard (code == 206 || (code == 200 && lo == 0)), let all = data else { retry(d, "HTTP \(code)"); return }
+            let piece = code == 200 ? all.prefix(Int(len)) : all
+            guard Int64(piece.count) == len, sync.hex(SHA256.hash(data: piece)) == p.chunks[i] else { retry(d, "piece \(i) of \(name) does not match the manifest"); return }
+            let fd = open(sync.partURL(name).path, O_RDWR); guard fd >= 0 else { lastError = "cannot open \(name).part"; return }
+            let w = piece.withUnsafeBytes { pwrite(fd, $0.baseAddress, piece.count, off_t(lo)) }
+            fsync(fd); close(fd)
+            guard w == piece.count else { lastError = "write failed: is the phone full?"; return }
+            st.done[i] = true; states[name] = st
+            try? JSONEncoder().encode(st).write(to: sync.stateURL(name), options: .atomic)
+            sync.progress.add(done: len, fetched: len)
+        }
+        onProgress?()
+        pump(["msl.tar", "romfs.img"])
+    }
+
+    func urlSession(_ s: URLSession, task t: URLSessionTask, didCompleteWithError error: Error?) {
+        guard let e = error, let d = t.taskDescription else { return }
+        if (e as? URLError)?.code == .cancelled { q.sync { _ = queued.remove(d) }; return }
+        q.sync { queued.remove(d); retry(d, e.localizedDescription) }
+        pump(["msl.tar", "romfs.img"])
+    }
+
+    private func retry(_ d: String, _ why: String) {   // on q; the next pump queues the piece again
+        let n = (retries[d] ?? 0) + 1; retries[d] = n
+        fputs("game data (background): \(d): \(why); attempt \(n)\n", stderr)
+        if n > 6 { lastError = "\(d.replacingOccurrences(of: "#", with: " piece ")) keeps failing: \(why)" }
+    }
+
+    func urlSessionDidFinishEvents(forBackgroundURLSession s: URLSession) {
+        let done = Self.liveLock.withLock { Self.eventsDone.removeValue(forKey: identifier) }
+        if let h = done { DispatchQueue.main.async { h() } }
+    }
+}
diff --git a/dm/ios/Sources/GameDataSync.swift b/dm/ios/Sources/GameDataSync.swift
new file mode 100644
index 0000000..9f59823
--- /dev/null
+++ b/dm/ios/Sources/GameDataSync.swift
@@ -0,0 +1,200 @@
+// The launcher's Game data server section: download, update and delete this game's data from the player's own server (GameDataSyncCore.swift does the work,
+// docs/game-data-server.md describes the server). The server address and access token come from the fields here, or once from Documents/env.txt
+// (DM_DATA_SERVER, DM_DATA_TOKEN). The download runs while the launcher is open; leaving the app pauses it, and the next Download resumes where it stopped.
+import SwiftUI
+import UIKit
+
+private func info(_ key: String) -> Any? { Bundle.main.object(forInfoDictionaryKey: key) }
+
+@MainActor
+final class GameDataModel: ObservableObject {
+    @Published var server: String { didSet { UserDefaults.standard.set(server, forKey: "gamedata.server") } }
+    @Published var token: String { didSet { UserDefaults.standard.set(token, forKey: "gamedata.token") } }
+    @Published var status = ""
+    @Published var running = false
+    @Published var line = ""          // "4.2 / 15.9 GB · 85 MB/s · 2 min left"
+    @Published var fraction = 0.0
+    @Published var note = ""
+    @Published var confirmDelete = false
+    @Published var background: Bool { didSet { UserDefaults.standard.set(background, forKey: "gamedata.background") } }   // GameDataBackground.swift: iOS keeps fetching while the app is away
+    private var task: Task<Void, Never>?
+    let gameDir = URL(fileURLWithPath: dm_game_dir())
+
+    init() {
+        let env = ProcessInfo.processInfo.environment
+        server = UserDefaults.standard.string(forKey: "gamedata.server") ?? env["DM_DATA_SERVER"] ?? ""
+        token = UserDefaults.standard.string(forKey: "gamedata.token") ?? env["DM_DATA_TOKEN"] ?? ""
+        background = UserDefaults.standard.object(forKey: "gamedata.background") as? Bool ?? true
+        refresh()
+        // A download that was running when the app was left (or that iOS kept going in the background) continues as soon as the launcher shows
+        if hasPartial && !server.isEmpty { note = "Continuing the download…"; DispatchQueue.main.async { [weak self] in self?.start() } }
+    }
+
+    var expected: String? { dm_expected_romfs_identity() }
+    /// The download folder as the Files app shows it: inside LiveContainer, below its Data/Application/<app folder>/
+    var whereShown: String {
+        let p = gameDir.path
+        // The last one: LiveContainer's own folder is a Data/Application/<id> too
+        if let r = p.range(of: "/Data/Application/", options: .backwards) { return "LiveContainer › Data › Application › " + p[r.upperBound...].split(separator: "/").joined(separator: " › ") }
+        if let r = p.range(of: "/Documents/") { return "On My iPhone › \((info("CFBundleDisplayName") as? String) ?? "the game") › " + p[r.upperBound...].split(separator: "/").joined(separator: " › ") }
+        return p
+    }
+    var imagePath: String { gameDir.appendingPathComponent("romfs.img").path }
+    var hasPartial: Bool { ["romfs.img.part.json", "msl.tar.part.json"].contains { FileManager.default.fileExists(atPath: gameDir.appendingPathComponent($0).path) } }
+    nonisolated static func identifier(_ title: String) -> String { "org.nxnative.gamedata." + title }   // one background session per game: two games in one LiveContainer do not share it
+    var imageOK: Bool { dm_romfs_status(imagePath) == 0 }
+    var hasAny: Bool { ["romfs.img", "romfs.img.part", "msl.tar", "msl.tar.part", "msl"].contains { FileManager.default.fileExists(atPath: gameDir.appendingPathComponent($0).path) } }
+
+    func refresh() {
+        let want = expected.flatMap { romfsIdentityField($0, "version") } ?? ""
+        var parts: [String] = []
+        switch dm_romfs_status(imagePath) {
+        case 0: parts.append("Game files ready" + (want.isEmpty ? "" : " (\(want))"))
+        case 3: parts.append("Game files are another version: update to \(want)")
+        case 2: parts.append(hasPartial ? "Game files partly downloaded" : "Game files incomplete")
+        default: parts.append(hasPartial ? "Game files partly downloaded" : "No downloaded game files")
+        }
+        parts.append(dm_have_shaders() ? "shaders ready" : "shaders missing")
+        status = parts.joined(separator: ", ")
+        var stale: ObjCBool = false
+        if let picked = dm_picked_data_path(&stale), imageOK { note = "A location picked under Game data is in use (\((picked as NSString).lastPathComponent)): choose “Use the app's own data again” to play from the download." }
+    }
+
+    var buttonTitle: String {
+        if hasPartial { return "Resume download" }
+        if dm_romfs_status(imagePath) == 3 { return "Update game data" }
+        return imageOK && dm_have_shaders() ? "Check for updates" : "Download game data"
+    }
+
+    func start() {
+        guard !running else { return }
+        // Several addresses, separated by spaces or commas: the first that answers is used (a home or Tailscale address first is fast at home, the public one works anywhere)
+        let urls = server.split(whereSeparator: { $0 == " " || $0 == "," || $0 == "\n" }).compactMap { URL(string: String($0)) }.filter { $0.scheme == "https" || $0.scheme == "http" }
+        guard !urls.isEmpty else { note = "Enter the server address, e.g. https://games.example.com/data"; return }
+        running = true; note = ""; confirmDelete = false
+        UIApplication.shared.isIdleTimerDisabled = true
+        let sync = GameDataSync(servers: urls, token: token.trimmingCharacters(in: .whitespaces), gameDir: gameDir)
+        let want = expected
+        task = Task { [weak self] in
+            let ticker = Task { [weak self] in await self?.tick(sync.progress, sync) }
+            defer { ticker.cancel() }
+            do {
+                let (m, base) = try await sync.manifest(title: dm_game_title(), build: want.flatMap { romfsIdentityField($0, "build") })
+                if let w = want, let have = m.romfs.identity, romfsIdentityKey(w) != romfsIdentityKey(have) {
+                    throw GameDataError.mismatch("The server has \(m.name ?? m.title) \(m.version) (\(m.build)), but this app was built for \(romfsIdentityField(w, "version") ?? "another version"): publish that version, or install the matching app.")
+                }
+                let ownShaders = Bundle.main.resourceURL.map { FileManager.default.fileExists(atPath: $0.appendingPathComponent("msl").appendingPathComponent(dm_shader_dir_name()).path) } ?? false
+                var files: [(GameDataManifest.Part, String)] = []
+                if let s = m.shaders, !ownShaders {   // an IPA that carries its shaders (the default build) does not fetch them again
+                    if let d = s.dir, d != dm_shader_dir_name() { throw GameDataError.mismatch("The server's shaders are \(d), this app needs \(dm_shader_dir_name() ?? "another version"): install the app from the same build as the server's data (or publish that build).") }
+                    files.append((s, "msl.tar"))
+                }
+                files.append((m.romfs, "romfs.img"))
+                let accepts: (String) -> (URL) -> Bool = { n in n == "romfs.img" ? { dm_romfs_status($0.path) == 0 } : { _ in true } }
+                var todo: [String: [Int]] = [:]
+                for (p, n) in files { todo[n] = try await sync.prepare(p, base: base, name: n) }
+                if self?.background == true {
+                    // Handed to iOS: it keeps fetching while the app is away; this loop only watches, and Pause cancels what is still queued
+                    let bg = GameDataBackground.shared(identifier: Self.identifier(m.title), sync: sync)
+                    bg.reset(); bg.pump(files.map { $0.1 })
+                    sync.progress.set(phase: "Downloading (continues in the background)")
+                    do {
+                        while !files.allSatisfy({ sync.complete($0.1) }) {
+                            if let e = bg.lastError { throw GameDataError.server(e) }
+                            try await Task.sleep(nanoseconds: 500_000_000)
+                            if bg.pending == 0 { bg.pump(files.map { $0.1 }) }   // nothing queued but pieces missing (a cancelled or given-up piece): queue again
+                        }
+                    } catch { if error is CancellationError { bg.cancelAll() }; throw error }
+                } else {
+                    for (p, n) in files { try await sync.fetchForeground(p, base: base, name: n, todo: todo[n] ?? []) }
+                }
+                for (_, n) in files { try sync.finish(n, accepts: accepts(n)) }
+                self?.finish("Done: \(m.name ?? "game data") \(m.version) is ready (from \(sync.using?.host ?? "the server")). Press Play.")
+            } catch is CancellationError {
+                self?.finish("Paused. Download resumes where it stopped.")
+            } catch {
+                self?.finish(error.localizedDescription + (self?.hasPartial == true ? " What is done is kept: Resume continues." : ""))
+            }
+        }
+    }
+
+    func cancel() { task?.cancel() }
+
+    private func finish(_ msg: String) {
+        running = false; line = ""; task = nil
+        UIApplication.shared.isIdleTimerDisabled = false
+        refresh(); note = msg
+    }
+
+    private func tick(_ p: GameDataProgress, _ sync: GameDataSync) async {
+        var last = p.fetched, lastT = Date(), speed = 0.0
+        while !Task.isCancelled {
+            try? await Task.sleep(nanoseconds: 500_000_000)
+            let now = Date(), f = p.fetched, dt = now.timeIntervalSince(lastT)
+            if dt > 0 { let s = Double(f - last) / dt; speed = speed == 0 ? s : speed * 0.8 + s * 0.2 }
+            last = f; lastT = now
+            let total = max(p.total, 1), done = p.done
+            fraction = min(Double(done) / Double(total), 1)
+            let gb = { (b: Int64) in String(format: "%.1f", Double(b) / 1e9) }
+            var s = "\(p.phase): \(gb(done)) / \(gb(total)) GB" + (sync.using?.host.map { " via \($0)" } ?? "")
+            if speed > 1e5 {
+                s += String(format: " · %.0f MB/s", speed / 1e6)
+                let left = Double(total - done) / speed
+                s += left < 90 ? " · \(Int(left)) s left" : " · \(Int(left / 60)) min left"
+            }
+            line = s
+        }
+    }
+
+    func delete() {
+        guard confirmDelete else { confirmDelete = true; return }
+        confirmDelete = false
+        do {
+            try GameDataSync(servers: [], token: "", gameDir: gameDir).deleteGameData()
+            refresh(); note = "Game data deleted. Your saves are kept."
+        } catch { note = "Could not delete: \(error.localizedDescription)" }
+    }
+}
+
+struct GameDataServerSection: View {
+    @StateObject private var m = GameDataModel()
+
+    var body: some View {
+        Section {
+            TextField("Server address(es): home first, then public, separated by spaces", text: $m.server, axis: .vertical)
+                .keyboardType(.URL).textInputAutocapitalization(.never).autocorrectionDisabled().disabled(m.running)
+            SecureField("Access token (if the server asks for one)", text: $m.token).disabled(m.running)
+            Toggle("Keep downloading in the background", isOn: $m.background).disabled(m.running)
+            Text(m.status).foregroundStyle(.secondary)
+            if m.running {
+                ProgressView(value: m.fraction)
+                Text(m.line).font(.callout).monospacedDigit().foregroundStyle(.secondary)
+                Button("Pause", role: .cancel) { m.cancel() }
+            } else {
+                Button(m.buttonTitle) { m.start() }
+                if m.hasAny {
+                    Button(m.confirmDelete ? "Tap again to delete the game data" : "Delete game data", role: .destructive) { m.delete() }
+                }
+            }
+        } header: {
+            Text("Game data")
+        } footer: {
+            VStack(alignment: .leading, spacing: 6) {
+                if !m.note.isEmpty { Text(m.note) }
+                Text("Downloads this game's files from your server, and resumes if interrupted. Delete frees the space and keeps your saves.")
+                Text("In Files: \(m.whereShown)").font(.caption.monospaced())
+            }
+        }
+    }
+}
+
+// main.m's app delegate: iOS relaunched the app in the background because a game data download has news; the session is made again to take it,
+// and the completion handler is called once it has (GameDataBackground.urlSessionDidFinishEvents)
+@_cdecl("dm_gamedata_background_events")
+public func dmGamedataBackgroundEvents(_ identifier: NSString, _ done: @escaping @convention(block) () -> Void) {
+    let id = identifier as String
+    guard id == GameDataModel.identifier(dm_game_title()) else { done(); return }
+    GameDataBackground.liveLockedSetDone(id, done)
+    let sync = GameDataSync(servers: [], token: UserDefaults.standard.string(forKey: "gamedata.token") ?? "", gameDir: URL(fileURLWithPath: dm_game_dir()))
+    _ = GameDataBackground.shared(identifier: id, sync: sync)
+}
diff --git a/dm/ios/Sources/GameDataSyncCore.swift b/dm/ios/Sources/GameDataSyncCore.swift
new file mode 100644
index 0000000..c3912a9
--- /dev/null
+++ b/dm/ios/Sources/GameDataSyncCore.swift
@@ -0,0 +1,259 @@
+// Game data download, the part without UI (GameDataSync.swift draws it in the launcher): fetches this build's game data from the player's own server
+// (docs/game-data-server.md, scripts/publish_gamedata.py writes what it serves) into the per-game layout main.m reads, Documents/games/<title ID>/:
+//   romfs.img   the game files, one image (dm/host/romfs_image.h). Fetched in 16 MiB chunks with HTTP Range requests, several at a time, each checked
+//               against the manifest's SHA-256 before it is written in place. That one mechanism gives resuming (chunks already done are kept in
+//               romfs.img.part.json), updates that only fetch what changed (a previous version's chunks that still match are kept) and no second copy
+//               of 16 GB on the phone. Only a complete image whose identity is the one this build needs (the check main.m makes) becomes romfs.img.
+//   msl.tar     the shader libraries of an IPA built with --shaders separate: an uncompressed ustar of b-<version>/, fetched the same way and kept as it is;
+//               the host reads the libraries straight from it (dm/gfx/nvn/nvn_mtl.m msl_pack_open), so nothing is unpacked.
+// Saves (games/<id>/save, Documents/save) are never touched, and deleting the game data keeps them.
+// Foundation and CryptoKit only, so the same file builds into a Mac test (dm/ios/tests/gamedata_sync_check.sh).
+import Foundation
+import CryptoKit
+
+struct GameDataManifest: Decodable {
+    struct Part: Decodable {
+        let url: String           // relative to the manifest's URL
+        let size: Int64
+        let sha256: String        // the whole file (for the server side's own checks; the app checks the chunks)
+        let chunkSize: Int64
+        let chunks: [String]      // SHA-256 of each chunkSize piece, the last one shorter
+        let identity: String?     // romfs: the identity line (dm/host/romfs_identity.h) of the image
+        let dir: String?          // shaders: the folder the tar holds, b-<translation chain version>
+        enum CodingKeys: String, CodingKey { case url, size, sha256, chunkSize = "chunk_size", chunks, identity, dir }
+    }
+    let format: Int
+    let title: String
+    let name: String?
+    let version: String
+    let build: String
+    let romfs: Part
+    let shaders: Part?
+}
+
+enum GameDataError: LocalizedError {
+    case server(String), mismatch(String), local(String)
+    var errorDescription: String? {
+        switch self { case .server(let s), .mismatch(let s), .local(let s): return s }
+    }
+    var isAccess: Bool { if case .server(let s) = self { return s.hasPrefix("The server refused") }; return false }
+}
+
+/// size= and index= of an identity line: what decides a match (romfs_identity.h), the rest only names the image.
+func romfsIdentityKey(_ line: String) -> String {
+    line.split(separator: " ").filter { $0.hasPrefix("size=") || $0.hasPrefix("index=") }.sorted().joined(separator: " ")
+}
+func romfsIdentityField(_ line: String, _ key: String) -> String? {
+    line.split(separator: " ").first { $0.hasPrefix(key + "=") }.map { String($0.dropFirst(key.count + 1)) }
+}
+
+/// Byte counts for the progress line: done counts every byte that is in place, fetched or kept.
+final class GameDataProgress: @unchecked Sendable {
+    private let lock = NSLock()
+    private var _total: Int64 = 0, _done: Int64 = 0, _fetched: Int64 = 0, _phase = ""
+    var total: Int64 { lock.withLock { _total } }
+    var done: Int64 { lock.withLock { _done } }
+    var fetched: Int64 { lock.withLock { _fetched } }   // over the network: what the speed is measured on
+    var phase: String { lock.withLock { _phase } }
+    func set(phase: String, total: Int64? = nil) { lock.withLock { _phase = phase; if let t = total { _total = t } } }
+    func add(done d: Int64, fetched f: Int64) { lock.withLock { _done += d; _fetched += f } }
+}
+
+extension Range where Bound == Int64 { var len: Int64 { upperBound - lowerBound } }
+
+final class GameDataSync: @unchecked Sendable {
+    static let chunkParallel = 6
+    let servers: [URL]        // e.g. a home address first, then https://games.example.com/data; the manifests are at <server>/<title ID>/[<build>/]manifest.json
+    private(set) var using: URL?   // the address that answered: the files come from it too (their URLs are relative to its manifest)
+    let token: String
+    let gameDir: URL
+    let progress = GameDataProgress()
+    private let session: URLSession, probe: URLSession
+
+    init(servers: [URL], token: String, gameDir: URL) {
+        self.servers = servers; self.token = token; self.gameDir = gameDir
+        let q = URLSessionConfiguration.ephemeral   // asking an address that is not reachable from here (the home one, away from home) gives up fast
+        q.timeoutIntervalForRequest = 4; q.waitsForConnectivity = false
+        probe = URLSession(configuration: q)
+        let c = URLSessionConfiguration.default
+        c.requestCachePolicy = .reloadIgnoringLocalCacheData; c.urlCache = nil
+        c.httpMaximumConnectionsPerHost = Self.chunkParallel
+        c.timeoutIntervalForRequest = 60
+        c.waitsForConnectivity = true
+        session = URLSession(configuration: c)
+    }
+
+    func request(_ url: URL, range: Range<Int64>? = nil) -> URLRequest {
+        var r = URLRequest(url: url)
+        if !token.isEmpty { r.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization") }
+        if let g = range { r.setValue("bytes=\(g.lowerBound)-\(g.upperBound - 1)", forHTTPHeaderField: "Range") }
+        r.setValue("identity", forHTTPHeaderField: "Accept-Encoding")   // never compressed: a Range is a byte range of the file as stored
+        return r
+    }
+
+    /// This build's manifest: <server>/<title>/<build>/manifest.json (exactly the version the app needs), else the latest one at <server>/<title>/manifest.json,
+    /// from the first address that answers (a home or Tailscale address before the public one): the download then runs from that address.
+    func manifest(title: String, build: String?) async throws -> (GameDataManifest, URL) {
+        var last = "no address"
+        for server in servers {
+            var urls: [URL] = []
+            let base = server.appendingPathComponent(title)
+            if let b = build, !b.isEmpty { urls.append(base.appendingPathComponent(b).appendingPathComponent("manifest.json")) }
+            urls.append(base.appendingPathComponent("manifest.json"))
+            for u in urls {
+                let data: Data, resp: URLResponse
+                do { (data, resp) = try await probe.data(for: request(u)) }
+                catch { last = "\(server.host ?? server.absoluteString): \(error.localizedDescription)"; fputs("game data: \(last); trying the next address\n", stderr); break }
+                let code = (resp as? HTTPURLResponse)?.statusCode ?? 0
+                if code == 401 || code == 403 { throw GameDataError.server("The server refused access (HTTP \(code)) at \(server.host ?? ""): check the access token.") }
+                guard code == 200 else { last = "HTTP \(code) for \(u.absoluteString)"; continue }
+                do { let m = try JSONDecoder().decode(GameDataManifest.self, from: data); using = server; fputs("game data: using \(server.absoluteString)\n", stderr); return (m, u) }
+                catch { throw GameDataError.server("The manifest at \(u.absoluteString) cannot be read: \(error.localizedDescription)") }
+            }
+        }
+        throw GameDataError.server("No game data for \(title) on the server (\(last)).")
+    }
+
+    private func fetch(_ url: URL, _ range: Range<Int64>, sha: String) async throws -> Data {
+        var wait: UInt64 = 1
+        for attempt in 1...6 {
+            try Task.checkCancellation()
+            do {
+                let (data, resp) = try await session.data(for: request(url, range: range))
+                let code = (resp as? HTTPURLResponse)?.statusCode ?? 0
+                if code == 401 || code == 403 { throw GameDataError.server("The server refused access (HTTP \(code)): check the access token.") }
+                guard code == 206 || (code == 200 && range.lowerBound == 0) else { throw GameDataError.server("HTTP \(code) for \(url.lastPathComponent): the server must answer Range requests (206)") }
+                let d = code == 200 ? data.prefix(Int(range.len)) : data
+                guard Int64(d.count) == range.len else { throw GameDataError.server("short read: \(d.count) of \(range.len) bytes") }
+                guard hex(SHA256.hash(data: d)) == sha else { throw GameDataError.mismatch("chunk at \(range.lowerBound) of \(url.lastPathComponent) does not match the manifest") }
+                return Data(d)
+            } catch let e as GameDataError where e.isAccess {
+                throw e   // a wrong token does not get better by retrying
+            } catch is CancellationError { throw CancellationError()
+            } catch {
+                if Task.isCancelled || (error as? URLError)?.code == .cancelled { throw CancellationError() }   // URLSession reports a cancelled task as its own error
+                if attempt == 6 { throw error }
+                fputs("game data: \(url.lastPathComponent) bytes \(range.lowerBound): \(error.localizedDescription); retry \(attempt) in \(wait) s\n", stderr)
+                try await Task.sleep(nanoseconds: wait * 1_000_000_000); wait = min(wait * 2, 30)
+            }
+        }
+        throw CancellationError()
+    }
+
+    func hex<D: Digest>(_ d: D) -> String { d.map { String(format: "%02x", $0) }.joined() }
+    func ranges(_ p: GameDataManifest.Part) -> [Range<Int64>] {
+        (0..<p.chunks.count).map { i in Int64(i) * p.chunkSize ..< min(Int64(i + 1) * p.chunkSize, p.size) }
+    }
+
+    // MARK: one file of the game data (the image, the shader archive)
+
+    struct FileState: Codable { var identity: String; var size: Int64; var chunkSize: Int64; var done: [Bool] }
+    /// What a download of one file needs after a restart, kept as <name>.part.plan.json: the background mode (GameDataBackground.swift) reads it when iOS
+    /// hands it finished pieces, perhaps in a later launch of the app
+    struct FilePlan: Codable { var name: String; var url: URL; var size: Int64; var chunkSize: Int64; var chunks: [String]; var identity: String }
+
+    func planURL(_ name: String) -> URL { gameDir.appendingPathComponent(name + ".part.plan.json") }
+    func stateURL(_ name: String) -> URL { gameDir.appendingPathComponent(name + ".part.json") }
+    func partURL(_ name: String) -> URL { gameDir.appendingPathComponent(name + ".part") }
+
+    /// Readies gameDir/<name>.part for the manifest's file: a previous version or an interrupted download becomes the starting point, and every piece
+    /// that already matches is kept. Returns the pieces still to fetch (none: finish() completes it).
+    func prepare(_ p: GameDataManifest.Part, base: URL, name: String) async throws -> [Int] {
+        let fm = FileManager.default
+        try fm.createDirectory(at: gameDir, withIntermediateDirectories: true)
+        let final = gameDir.appendingPathComponent(name), part = partURL(name), stateURL = stateURL(name)
+        guard p.chunks.count == Int((p.size + p.chunkSize - 1) / max(p.chunkSize, 1)) else { throw GameDataError.server("the manifest's chunk list does not cover \(name)") }
+        // A previous version becomes the starting point: its chunks that still match are kept (an update fetches only what changed), with no second copy
+        if fm.fileExists(atPath: final.path) && !fm.fileExists(atPath: part.path) { try fm.moveItem(at: final, to: part) }
+        let fresh = !fm.fileExists(atPath: part.path)
+        let fd = open(part.path, O_RDWR | O_CREAT, 0o644)
+        guard fd >= 0 else { throw GameDataError.local("cannot open \(part.path) (errno \(errno))") }
+        defer { close(fd) }
+        guard ftruncate(fd, off_t(p.size)) == 0 else { throw GameDataError.local("not enough space for \(p.size / 1_000_000) MB (errno \(errno))") }
+        let id = p.identity ?? p.sha256
+        var state = (try? JSONDecoder().decode(FileState.self, from: Data(contentsOf: stateURL))).flatMap {
+            $0.identity == id && $0.size == p.size && $0.chunkSize == p.chunkSize && $0.done.count == p.chunks.count ? $0 : nil
+        } ?? FileState(identity: id, size: p.size, chunkSize: p.chunkSize, done: Array(repeating: false, count: p.chunks.count))
+        let rs = ranges(p)
+        progress.set(phase: "Checking the data on the phone", total: progress.total + p.size)
+        for (i, r) in rs.enumerated() where state.done[i] { progress.add(done: r.len, fetched: 0) }
+        // What is on disk already (an interrupted chunk, a previous version) is kept where it matches; a file made just now holds nothing to check
+        var todo: [Int] = []
+        var buf = [UInt8](repeating: 0, count: Int(p.chunkSize))
+        for (i, r) in rs.enumerated() where !state.done[i] {
+            try Task.checkCancellation()
+            if !fresh {
+                let n = buf.withUnsafeMutableBytes { pread(fd, $0.baseAddress, Int(r.len), off_t(r.lowerBound)) }
+                if n == Int(r.len) && hex(SHA256.hash(data: buf[0..<n])) == p.chunks[i] { state.done[i] = true; progress.add(done: r.len, fetched: 0); continue }
+            }
+            todo.append(i)
+        }
+        try JSONEncoder().encode(state).write(to: stateURL, options: .atomic)
+        let plan = FilePlan(name: name, url: URL(string: p.url, relativeTo: base)!.absoluteURL, size: p.size, chunkSize: p.chunkSize, chunks: p.chunks, identity: id)
+        try JSONEncoder().encode(plan).write(to: planURL(name), options: .atomic)
+        return todo
+    }
+
+    /// Fetches the pieces in this process, several at a time (the app has to stay open; the background mode is GameDataBackground.swift).
+    func fetchForeground(_ p: GameDataManifest.Part, base: URL, name: String, todo: [Int]) async throws {
+        let fd = open(partURL(name).path, O_RDWR); guard fd >= 0 else { throw GameDataError.local("cannot open \(name).part (errno \(errno))") }
+        defer { close(fd) }
+        let stateURL = stateURL(name)
+        var state = try JSONDecoder().decode(FileState.self, from: Data(contentsOf: stateURL))
+        let rs = ranges(p), url = URL(string: p.url, relativeTo: base)!.absoluteURL
+        progress.set(phase: todo.isEmpty ? "Checking" : name == "romfs.img" ? "Downloading game files" : "Downloading shaders")
+        let lock = NSLock(); var sinceSave = 0
+        try await withThrowingTaskGroup(of: Void.self) { g in
+            var next = todo.makeIterator()
+            func add() -> Bool {
+                guard let i = next.next() else { return false }
+                g.addTask { [self] in
+                    let r = rs[i], d = try await fetch(url, r, sha: p.chunks[i])
+                    let w = d.withUnsafeBytes { pwrite(fd, $0.baseAddress, d.count, off_t(r.lowerBound)) }
+                    guard w == d.count else { throw GameDataError.local("write failed at \(r.lowerBound) (errno \(errno)): is the phone full?") }
+                    progress.add(done: r.len, fetched: r.len)
+                    let snapshot: FileState? = lock.withLock { state.done[i] = true; sinceSave += 1; if sinceSave >= 8 { sinceSave = 0; return state }; return nil }
+                    if let s = snapshot { fsync(fd); try? JSONEncoder().encode(s).write(to: stateURL, options: .atomic) }
+                }
+                return true
+            }
+            for _ in 0..<Self.chunkParallel { if !add() { break } }
+            do { while try await g.next() != nil { _ = add() } }
+            catch { g.cancelAll(); fsync(fd); try? JSONEncoder().encode(lock.withLock { state }).write(to: stateURL, options: .atomic); throw error }
+        }
+        fsync(fd)
+        try JSONEncoder().encode(state).write(to: stateURL, options: .atomic)
+    }
+
+    /// True when every piece of <name> is in place (by its state file).
+    func complete(_ name: String) -> Bool {
+        (try? JSONDecoder().decode(FileState.self, from: Data(contentsOf: stateURL(name))))?.done.allSatisfy { $0 } ?? false
+    }
+
+    /// Swaps a complete <name>.part in as <name>. accepts: the final check (for the image, main.m's identity check on the device).
+    func finish(_ name: String, accepts: (URL) -> Bool = { _ in true }) throws {
+        let fm = FileManager.default, final = gameDir.appendingPathComponent(name), part = partURL(name)
+        guard complete(name) else { throw GameDataError.local("\(name) is not complete yet") }
+        progress.set(phase: "Checking")
+        guard accepts(part) else { throw GameDataError.mismatch("The downloaded \(name) is complete but is not the one this app needs: the server has another version.") }
+        if fm.fileExists(atPath: final.path) { try fm.removeItem(at: final) }
+        try fm.moveItem(at: part, to: final)
+        try? fm.removeItem(at: stateURL(name)); try? fm.removeItem(at: planURL(name))
+    }
+
+    /// Brings gameDir/<name> (romfs.img, msl.tar) to the manifest's file, fetched in this process.
+    func syncFile(_ p: GameDataManifest.Part, base: URL, name: String, accepts: (URL) -> Bool = { _ in true }) async throws {
+        let todo = try await prepare(p, base: base, name: name)
+        try await fetchForeground(p, base: base, name: name, todo: todo)
+        try finish(name, accepts: accepts)
+    }
+
+    /// Deletes the downloaded game data: the image, the shader libraries and any half-done download. The saves (games/<id>/save) stay.
+    func deleteGameData() throws {
+        let fm = FileManager.default
+        for n in ["romfs.img", "romfs.img.part", "romfs.img.part.json", "romfs.img.part.plan.json", "msl.tar", "msl.tar.part", "msl.tar.part.json", "msl.tar.part.plan.json", "msl", "msl.part", "msl.part.json", "temp"] {
+            let u = gameDir.appendingPathComponent(n)
+            if fm.fileExists(atPath: u.path) { try fm.removeItem(at: u) }
+        }
+    }
+}
