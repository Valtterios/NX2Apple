+#!/usr/bin/env python3
+"""Publish games' shell frameworks to your game data server's folder, for the shell app's Get games (dm/ios/Shell/ShellStore.swift).
+
+    python3 scripts/publish_shell.py ~/Games/shell-fw/DmGame<title ID>.framework [...] --out /srv/games
+
+Each framework (build_ipa_from_nsp.py --shell-framework) is packed as an uncompressed ustar and listed in the catalogue, under --out:
+    data/shell/<title ID>/<chain>/DmGame<title ID>.framework.tar   the framework, as the app unpacks it into its own Frameworks folder
+    data/shell/<title ID>/icon.<ext>                               the game's icon
+    data/shell/catalog.json                                       every published game: name, version, build, the tar's size and chunk hashes
+The game's data comes from the game's own manifest, data/<title ID>/<build>/manifest.json (publish_gamedata.py, with --no-shaders when the
+game is only played in the shell: its shader libraries are in the framework). That manifest names the build and version listed here.
+"""
+import argparse, json, sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from publish_gamedata import part, ustar   # noqa: E402
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
+    ap.add_argument('frameworks', nargs='+', type=Path, help='DmGame<title ID>.framework folders')
+    ap.add_argument('--out', type=Path, required=True, help="the server's root folder (data/ goes in it)")
+    a = ap.parse_args()
+    shell = a.out / 'data' / 'shell'
+    cat_path = shell / 'catalog.json'
+    cat = json.loads(cat_path.read_text()) if cat_path.exists() else {'format': 1, 'chain': None, 'games': []}
+    for fw in a.frameworks:
+        fw = fw.expanduser().resolve()
+        m = json.loads((fw / 'game.manifest.json').read_text())
+        tid, chain = m['title_id'].upper(), m['chain']
+        if cat['chain'] not in (None, chain):
+            sys.exit(f'{fw.name}: built for shader chain {chain}, the catalogue holds {cat["chain"]}: build every game again with one engine')
+        cat['chain'] = chain
+        data = json.loads((a.out / 'data' / tid / 'manifest.json').read_text()) if (a.out / 'data' / tid / 'manifest.json').exists() else None
+        if not data: sys.exit(f'{fw.name}: no data/{tid}/manifest.json under {a.out}: publish the game data first (publish_gamedata.py --no-shaders)')
+        tar = shell / tid / chain / f'{fw.name}.tar'
+        tar.parent.mkdir(parents=True, exist_ok=True)
+        print(f'  {fw.name}: packing')
+        ustar(fw, tar)
+        icon = next((p for p in sorted(fw.glob('icon.*'))), None)
+        entry = dict(id=tid, name=data.get('name') or m.get('name') or tid, version=data['version'], build=data['build'],
+                     framework=part(tar, f'{tid}/{chain}/{tar.name}'))
+        if icon:
+            (shell / tid / icon.name).write_bytes(icon.read_bytes())
+            entry['icon'] = f'{tid}/{icon.name}'
+        cat['games'] = [g for g in cat['games'] if g['id'] != tid] + [entry]
+        print(f'  {fw.name}: {entry["framework"]["size"] / 1e9:.2f} GB, {entry["name"]} {entry["version"]} ({entry["build"]})')
+    cat['games'].sort(key=lambda g: g['name'].lower())
+    tmp = cat_path.with_suffix('.tmp'); tmp.write_text(json.dumps(cat, indent=1)); tmp.replace(cat_path)
+    print(f'  catalogue  {cat_path} ({len(cat["games"])} games)')
+
+
+if __name__ == '__main__':
+    main()
