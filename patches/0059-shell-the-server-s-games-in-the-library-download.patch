+    /// The server's games for the library, with a local copy of each icon (the server asks for the token, the library reads files)
+    func publishToLibrary() async {
+        guard let cat = catalogue, let base = servers.first else { return }
+        let icons = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0].appendingPathComponent("shell-icons", isDirectory: true)
+        try? FileManager.default.createDirectory(at: icons, withIntermediateDirectories: true)
+        let sync = GameDataSync(servers: servers, token: token, gameDir: icons)
+        var games: [ServerGame] = []
+        for g in cat.games {
+            var icon: URL?
+            if let rel = g.icon {
+                let local = icons.appendingPathComponent("\(g.id).\((rel as NSString).pathExtension)")
+                if !FileManager.default.fileExists(atPath: local.path),
+                   let url = URL(string: rel, relativeTo: base.appendingPathComponent("shell/catalog.json")),
+                   let (data, resp) = try? await URLSession.shared.data(for: sync.request(url.absoluteURL)), (resp as? HTTPURLResponse)?.statusCode == 200 {
+                    try? data.write(to: local)
+                }
+                if FileManager.default.fileExists(atPath: local.path) { icon = local }
+            }
+            games.append(ServerGame(id: g.id, title: g.name, subtitle: "Version \(g.version)", iconURL: icon))
+        }
+        model.serverGames = games
