+    /// The kept copies, outside the app bundle: an app update replaces the bundle (and the frameworks in it), not Library/
+    static var kept: URL { FileManager.default.urls(for: .libraryDirectory, in: .userDomainMask)[0].appendingPathComponent("ShellGames", isDirectory: true) }
+
+    /// Puts back every kept game the bundle lacks (after an app update), as APFS clones: no second copy on the disk. Runs before the
+    /// library reads the Frameworks folder; a restored framework needs Force Sign again, as after a download.
+    static func restoreKept() {
+        let fm = FileManager.default
+        let frameworks = Bundle.main.privateFrameworksURL ?? Bundle.main.bundleURL.appendingPathComponent("Frameworks", isDirectory: true)
+        guard fm.isWritableFile(atPath: Bundle.main.bundlePath),
+              let names = try? fm.contentsOfDirectory(atPath: kept.path) else { return }
+        for name in names where name.hasSuffix(".framework") {
+            let src = kept.appendingPathComponent(name), dst = frameworks.appendingPathComponent(name)
+            let want = try? String(contentsOf: src.appendingPathComponent("shell-build.txt"), encoding: .utf8)
+            if fm.fileExists(atPath: dst.path), (try? String(contentsOf: dst.appendingPathComponent("shell-build.txt"), encoding: .utf8)) == want { continue }
+            try? fm.removeItem(at: dst)
+            try? fm.createDirectory(at: frameworks, withIntermediateDirectories: true)
+            do { try fm.copyItem(at: src, to: dst); fputs("shell: restored \(name) from the kept copy\n", stderr) }
+            catch { fputs("shell: could not restore \(name): \(error.localizedDescription)\n", stderr) }
+        }
     }
 
