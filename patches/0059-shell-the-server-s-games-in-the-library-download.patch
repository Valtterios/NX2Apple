+        }
+        if have != g.build {
+            return .server(status: "Update available", detail: "Version \(g.version) is on your server.", action: "Update", symbol: "arrow.down.circle")
+        }
+        if !dataReady(id) {
+            return .server(status: "Game data missing", detail: "The game's data did not finish downloading. Download resumes where it stopped.",
+                           action: "Download data", symbol: "arrow.down.circle")
+        }
+        if frameworkSignature(executable(id)) != .certificate {
+            return .server(status: "Force Sign needed", detail: Self.forceSignHelp, action: "How to Force Sign", symbol: "signature")
+        }
+        return nil
+    }
+    static let forceSignHelp = "Close this app, open its settings in LiveContainer and tap Force Sign, then open this app again. Needed once after each download or app update."
