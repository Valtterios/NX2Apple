+        let size = ByteCountFormatter.string(fromByteCount: g.framework.size, countStyle: .file)
+        if busy == id { return .server(status: "Downloading", detail: progress, action: "Downloading…", symbol: "arrow.down.circle") }
+        guard let have = installedBuild(id) else {
+            return .server(status: "Not downloaded", detail: "Downloads \(size) of game code and the game's data from your server. Keep the app open while it downloads.",
